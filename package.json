{
  "name": "zentro",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:store": "npm run dev -w @zentro/storefront",
    "dev:admin": "npm run dev -w @zentro/admin",
    "build": "npm run build -w @zentro/storefront && npm run build -w @zentro/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:dev": "node scripts/migrate.mjs --seed-dev",
    "admin:create-owner": "node scripts/create-owner.mjs"
  },
  "dependencies": {
    "postgres": "3.4.9"
  }
}
