# ---------------------------------------------------------------
# Zentro environment template. Copy to .env.local for development.
# NEVER commit real values. In production set these in your host
# (e.g. Vercel → Project → Settings → Environment Variables), with
# separate values for Preview (staging) and Production.
# ---------------------------------------------------------------

# development | staging | production
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection used ONLY by the server.
# Supabase → Project Settings → Database → Connection string →
# "Transaction pooler" (port 6543). Keep the password secret.
DATABASE_URL=postgres://zentro:zentro@localhost:5432/zentro_dev

# Supabase Auth (Phase 3). The anon key is public by design; the
# service-role key is a secret and is used only on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments — Razorpay (Phase 4). Use rzp_test_ keys in staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email/SMS providers (Phase 5)
RESEND_API_KEY=
EMAIL_FROM=
SMS_PROVIDER_API_KEY=

# ---------------------------------------------------------------
# Business details — shown on contact page, footer and invoices.
# Leave blank until you have the real values: blank fields are
# simply not displayed (nothing is invented).
# ---------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME=Zentro
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
# Two-letter GST state code where you ship from, e.g. KA, MH, TS
SELLER_STATE_CODE=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
# Days after delivery within which returns are accepted
RETURN_WINDOW_DAYS=7

# Shared secret Vercel Cron sends to /api/cron/maintenance (any long random string)
CRON_SECRET=
# Only for automated tests against a local mock gateway; leave blank in real use
RAZORPAY_API_BASE=

# ---------------------------------------------------------------
# Customer messaging (order updates + promotions)
# ---------------------------------------------------------------
# Signs one-click unsubscribe links. Promotions are not sent without it.
UNSUBSCRIBE_SECRET=
# Email — Resend (resend.com). Verify your sending domain first.
RESEND_API_KEY=
EMAIL_FROM="Zentro <orders@yourdomain.in>"
RESEND_WEBHOOK_SECRET=
# SMS — MSG91 with DLT registration (entity ID + sender header + approved
# templates are set up in MSG91; template IDs are entered per template in the admin).
MSG91_AUTH_KEY=
MSG91_WEBHOOK_TOKEN=
# WhatsApp Business — Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Shared with the admin: allows it to refresh cached product pages
REVALIDATE_SECRET=
