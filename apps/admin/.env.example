# Zentro Admin — copy to .env.local for development. Never commit real values.
# Production: set these in the admin project's environment (separate from the
# storefront), and serve the admin on its own domain, e.g. admin.yourstore.in.

APP_ENV=development
ADMIN_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000

# Same database as the storefront (one inventory, one order ledger).
DATABASE_URL=postgres://zentro:zentro@localhost:5432/zentro_dev

# 32 random bytes, base64 — encrypts staff MFA secrets at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_ENCRYPTION_KEY=

# Payment gateway (refunds/reconciliation, admin Phase 4) — server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Business (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Shared with the storefront: messages are sent from both apps (the admin sends
# one-to-one and test messages immediately; the storefront cron sends the rest).
UNSUBSCRIBE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
MSG91_AUTH_KEY=
NEXT_PUBLIC_BUSINESS_NAME=Zentro

# Same values as the storefront — used on finance and GST reports.
BUSINESS_LEGAL_NAME=
BUSINESS_GSTIN=
# 2-letter state code where you're GST-registered (decides CGST+SGST vs IGST)
SELLER_STATE_CODE=

# Shared with the storefront: lets the admin refresh cached product pages
REVALIDATE_SECRET=

# Shared with the storefront: signs customer support-request links
TICKET_LINK_SECRET=

# Media: "supabase" (production, Supabase Storage bucket) or blank (stored in the database)
MEDIA_STORAGE=
MEDIA_BUCKET=product-media
# Comma-separated https image hosts allowed for image links (both apps)
MEDIA_REMOTE_HOSTS=images.unsplash.com
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
